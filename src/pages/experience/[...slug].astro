---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, CLUSTERS } from '../../data/site';
import { formatDate } from '../../lib/content';
import '../../styles/article.css';

export async function getStaticPaths() {
  const entries = await getCollection('experience', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const url = new URL(`/experience/${entry.id}`, SITE.url).href;
const cluster = CLUSTERS[data.cluster];

const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: data.title,
    description: data.description,
    datePublished: data.publishDate.toISOString(),
    dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
    inLanguage: 'en',
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    // First-hand writing by a named person: the core experience signal.
    author: { '@id': `${SITE.url}/#person-sandeep`, name: data.author },
    publisher: { '@id': `${SITE.url}/#organization` },
    about: cluster.label,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Experience', item: `${SITE.url}/experience` },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
---
<Base title={`${data.title} | Intelleo`} description={data.description} ogType="article" schema={schema}>
  <article class="article">
    <div class="wrap article-inner">
      <nav class="article-meta" aria-label="Breadcrumb">
        <a href="/experience">Experience</a>
        <span aria-hidden="true">/</span>
        <a href={`/topics/${data.cluster}`}>{cluster.label}</a>
      </nav>
      <h1>{data.title}</h1>
      <div class="article-meta">
        <span class="badge">{cluster.label}</span>
        <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
        {data.updatedDate && <span>Updated {formatDate(data.updatedDate)}</span>}
        <span><a href="/about">{data.author}</a></span>
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>
