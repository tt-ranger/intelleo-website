---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { SITE, CLUSTERS, CLUSTER_IDS, type ClusterId } from '../../data/site';
import { getPublished, type Post } from '../../lib/content';
import '../../styles/article.css';

export async function getStaticPaths() {
  const posts = await getPublished();
  return CLUSTER_IDS.map((id) => ({
    params: { cluster: id },
    props: { cluster: id, posts: posts.filter((p) => p.data.cluster === id) },
  }));
}

const { cluster, posts } = Astro.props as { cluster: ClusterId; posts: Post[] };
const meta = CLUSTERS[cluster];
const url = `${SITE.url}/topics/${cluster}`;

// Group by subject so the hub reads as a structured cluster, not a flat feed.
const bySubject = new Map<string, Post[]>();
for (const p of posts) {
  const list = bySubject.get(p.data.subject) ?? [];
  list.push(p);
  bySubject.set(p.data.subject, list);
}
const subjects = [...bySubject.entries()].sort((a, b) => b[1].length - a[1].length);
const label = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#collection`,
    name: `${meta.label} — Intelleo`,
    url,
    description: meta.blurb,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'Thing', name: meta.label },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Topics', item: `${SITE.url}/topics` },
      { '@type': 'ListItem', position: 3, name: meta.label, item: url },
    ],
  },
];
---
<Base title={`${meta.label} — Intelleo`} description={meta.blurb} schema={schema}>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Topic</span>
      <h1>{meta.label}</h1>
      <p>{meta.blurb}</p>
    </div>
  </section>

  {subjects.length > 0 && (
    <section style="padding-top:32px;padding-bottom:0">
      <div class="wrap">
        <div class="hub-grid">
          {subjects.map(([subject, list]) => (
            <a class="hub-card" href={`#${subject}`}>
              <span class="count">{list.length} article{list.length === 1 ? '' : 's'}</span>
              <h3>{label(subject)}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="padding-top:48px">
    <div class="wrap">
      {subjects.length === 0 ? (
        <p class="muted">Nothing published in this topic yet.</p>
      ) : (
        subjects.map(([subject, list]) => (
          <div id={subject} style="margin-bottom:56px">
            <h2>{label(subject)}</h2>
            <PostList posts={list} />
          </div>
        ))
      )}
      <p style="margin-top:40px"><a class="btn btn-ghost" href="/blog">All insights</a></p>
    </div>
  </section>
</Base>
