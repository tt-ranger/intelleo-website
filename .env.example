# Google Analytics 4 measurement ID. Leave unset to disable analytics entirely.
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Legacy standalone Jev script. The publisher and npm review use LiteLLM.
# Two routes reach the Jev model;
# scripts/lib/jev.mjs reads whichever key is present straight out of .env.
#
# Default route: OpenRouter, model typesafe/jev-1.13.
OPEN_ROUTER_API_KEY=

# Alternate route: Vercel AI Gateway, model typesafe-ai/jev. Select it with
# --transport=gateway. Needs a card on file with Vercel. The dash in the name
# is deliberate; it is read from .env and passed as AI_GATEWAY_API_KEY.
vercel-api-key=

# Autonomous publishing. The production workflow receives these as secrets.
DB_CONNECTION_STRING=
# Administrator connection for npm run publisher -- migrate.
DB_MIGRATION_CONNECTION_STRING=
PUBLISH_DB_ROOT_CERT=
LITELLM_URL=
LITELLM_KEY=
# Include gateway markup and any account-specific pricing.
LITELLM_PRICE_MULTIPLIER=1.15
YOU_DOT_COM_API_KEY=
PUBLISH_GITHUB_APP_ID=
PUBLISH_GITHUB_INSTALLATION_ID=
PUBLISH_GITHUB_APP_PRIVATE_KEY=
PUBLISH_MODE=shadow
